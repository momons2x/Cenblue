{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages/**/*.ts", "workers/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["apps/dashboard", "node_modules"]
}
