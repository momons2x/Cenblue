CENBLU_ROOT="/absolute/path/to/cenblu"
DATABASE_URL="file:../../../storage/cenblu.db"
APP_TIMEZONE="Asia/Jakarta"
# Trusted hostnames that proxy dashboard Server Action requests, comma-separated.
# DASHBOARD_ALLOWED_ORIGINS="cenblu.local,192.168.1.20:3000"
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_PROFILE_PATH="./storage/browser-profile"
# The PLAYWRIGHT profile is collector-only and may retain the existing collector login.
# Optional read-only source used by `pnpm publisher:profile:clone`.
# PLAYWRIGHT_PROFILE_SOURCE_PATH="C:/Users/you/AppData/Local/Microsoft/Edge/User Data"
PLAYWRIGHT_PROFILE_DIRECTORY="Default"
# Fresh isolated profile used only for publishing and published-post metrics.
PUBLISHER_PROFILE_PATH="./storage/browser-profile-publisher"
# Leave unset for a fresh profile created by `pnpm publisher:login`.
# PUBLISHER_PROFILE_DIRECTORY="Default"
PLAYWRIGHT_BROWSER_CHANNEL="msedge"
PLAYWRIGHT_ALLOW_EXTERNAL_PROFILE=false
PUBLISH_ALLOW_EMPTY_CAPTION=false
# Adaptive uploads assume at least this sustained upstream speed and never wait beyond the maximum.
PUBLISH_MIN_UPLOAD_MBPS=2
PUBLISH_MAX_UPLOAD_MINUTES=45
SOURCE_ACCOUNT_LIMIT=3
POSTS_PER_SOURCE=5
VIDEO_ONLY=true
PUBLISH_INTERVAL_MINUTES=60
COLLECTION_INTERVAL_MINUTES=15
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_BATCH_LIMIT=20
WORKER_LOCK_TIMEOUT_MINUTES=30
COLLECTOR_MAX_SCROLLS=60
COLLECTOR_IDLE_SCROLLS=8
COLLECTOR_SCROLL_DELAY_MS=1200
COLLECTOR_MAX_SOURCE_SECONDS=300
PUBLISH_MODE="ASSISTED"
# Separate rotating caption templates with a line containing only ---.
CAPTION_TEMPLATES="{sourceCaption}"
VIDEO_STORAGE_PATH="./storage/videos"
TEMP_STORAGE_PATH="./storage/temp"
THUMBNAIL_STORAGE_PATH="./storage/thumbnails"
LOG_STORAGE_PATH="./storage/logs"
LOG_MAX_BYTES=5000000
LOG_RETAINED_FILES=5
BACKUP_STORAGE_PATH="./storage/backups"
# Prefer bare tool names on PATH. Absolute paths (for example WinGet package paths)
# can go stale when tools are upgraded or their package cache is cleaned, which
# causes spawn ENOENT errors. After changing any of these, restart the dashboard.
YTDLP_BINARY="yt-dlp"
FFMPEG_BINARY="ffmpeg"
FFPROBE_BINARY="ffprobe"
